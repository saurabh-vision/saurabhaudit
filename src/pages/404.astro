---
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import LinkButton from "@/components/LinkButton.astro";
import { SITE } from "@/config";
import Layout from "@/layouts/Layout.astro";
---

<Layout title={`404 Not Found | ${SITE.title}`} description="Page not found.">
  <Header />

  <main
    id="main-content"
    class="wide-container flex flex-1 items-center justify-center py-16"
  >
    <div class="flex flex-col items-center justify-center text-center">
      <h1 class="text-8xl sm:text-9xl font-bold text-accent">404</h1>
      <span aria-hidden="true" class="text-xl sm:text-2xl mt-2 text-muted">¯\_(ツ)_/¯</span>
      <p class="mt-4 text-2xl sm:text-3xl font-semibold">Page Not Found</p>
      <LinkButton
        href="/"
        class="mt-6 min-h-[44px] px-6 py-2.5 rounded-lg bg-surface border border-border hover:border-accent text-accent font-medium inline-flex items-center justify-center"
      >
        Go back home
      </LinkButton>
    </div>
  </main>

  <Footer />
</Layout>
