---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import Datetime from "@/components/Datetime.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import NewsletterForm from "@/components/NewsletterForm.astro";
import RelatedContent from "@/components/RelatedContent.astro";
import StructuredData from "@/components/StructuredData.astro";
import { SITE } from "@/config";
import Layout from "@/layouts/Layout.astro";
import { getBreadcrumbItems } from "@/utils/breadcrumbs";
import { getRelatedPool } from "@/utils/buildRelatedPool";
import { getNoteExcerpt } from "@/utils/getNoteExcerpt";
import { getNotePath } from "@/utils/getNotePath";
import { getRelatedContent } from "@/utils/getRelatedContent";
import { checkThinNote } from "@/utils/isThinNote";
import { publishedNoteFilter } from "@/utils/noteFilter";
import { slugifyStr } from "@/utils/slugify";

export interface Props {
  note: CollectionEntry<"notes">;
}

export async function getStaticPaths() {
  const notes = await getCollection("notes", publishedNoteFilter);
  return notes.map((note) => {
    const slug = slugifyStr(note.id.split("/").at(-1)?.replace(/\.(md|mdx)$/, "") ?? note.id);
    return {
      params: { slug },
      props: { note },
    };
  });
}

const { note } = Astro.props;
const {
  title,
  pubDatetime,
  modDatetime,
  tags = [],
  sourceUrl,
  sourceTitle,
} = note.data;

const { Content } = await render(note);

const thinCheck = checkThinNote(note);
const isThinOrUnlisted = thinCheck.isThin;

const description = getNoteExcerpt({
  title,
  description: note.data.description,
  body: note.body,
});

const noteUrl = new URL(getNotePath(note.id), Astro.site ?? Astro.url.origin).href;

const slug = slugifyStr(note.id.split("/").at(-1)?.replace(/\.(md|mdx)$/, "") ?? note.id);
const defaultNoteOg = `/notes/${slug}/index.png`;
const ogImageUrl = note.data.ogImage
  ? (typeof note.data.ogImage === "string" ? note.data.ogImage : (note.data.ogImage as any).src)
  : undefined;
const resolvedOgImage = ogImageUrl
  ? (ogImageUrl.startsWith("http") ? ogImageUrl : new URL(ogImageUrl, Astro.site ?? Astro.url.origin).href)
  : new URL(defaultNoteOg, Astro.site ?? Astro.url.origin).href;

let sourceHost = "";
if (sourceUrl) {
  try {
    sourceHost = new URL(sourceUrl).hostname.replace(/^www\./, "");
  } catch {
    sourceHost = sourceUrl;
  }
}
const sourceLabel = sourceTitle || sourceHost;

const pool = await getRelatedPool();
const relatedItems = getRelatedContent(
  {
    type: "Note",
    slug,
    title,
    tags,
    pubDatetime,
  },
  pool,
  3,
);
---

<Layout
  title={`${title} | ${SITE.title}`}
  description={description}
  canonicalURL={noteUrl}
  ogImage={resolvedOgImage}
  ogType="article"
  pubDatetime={pubDatetime}
  modDatetime={modDatetime}
  noindex={isThinOrUnlisted}
>
  <StructuredData
    type="NoteDetail"
    noindex={isThinOrUnlisted}
    data={{
      title,
      description,
      url: noteUrl,
      pubDatetime,
      modDatetime,
      image: resolvedOgImage,
      keywords: tags.join(", "),
    }}
  />
  <Header />

  <main
    id="main-content"
    data-pagefind-body={!isThinOrUnlisted ? "" : undefined}
    data-pagefind-ignore={isThinOrUnlisted ? "" : undefined}
    data-pagefind-filter={!isThinOrUnlisted ? "type:Note" : undefined}
    data-pagefind-meta={!isThinOrUnlisted ? "type:Note" : undefined}
    class="reading-container pb-12"
  >
    <Breadcrumbs
      items={getBreadcrumbItems("note", { title, url: noteUrl })}
      class="mt-6 mb-4"
    />

    <header class="pb-6 border-b border-border">
      <h1
        class="text-3xl font-bold tracking-tight sm:text-4xl text-foreground"
        data-pagefind-meta="title"
      >
        {title}
      </h1>

      <div class="mt-3 flex flex-wrap items-center gap-3 text-sm text-foreground/75">
        <Datetime
          pubDatetime={pubDatetime}
          modDatetime={modDatetime}
          timezone={undefined}
        />
        {
          sourceUrl && (
            <span class="inline-flex items-center gap-1 text-xs opacity-80">
              <span aria-hidden="true">&bull;</span>
              <span>Source:</span>
              <a
                href={sourceUrl}
                target="_blank"
                rel="noopener"
                class="font-mono underline hover:text-accent"
              >
                {sourceLabel}
              </a>
            </span>
          )
        }
      </div>
    </header>

    <article id="article" class="mx-auto prose mt-8 max-w-3xl leading-relaxed">
      <Content />
    </article>

    {
      tags && tags.length > 0 && (
        <div class="my-8 flex flex-wrap gap-2 pt-4 border-t border-border">
          {tags.map((tag: string) => (
            <a
              href={`/notes/tags/${slugifyStr(tag)}/`}
              class="inline-block rounded px-2.5 py-0.5 text-xs bg-muted/40 border border-border text-foreground/80 hover:border-accent hover:text-accent focus-outline"
            >
              #{tag}
            </a>
          ))}
        </div>
      )
    }

    <RelatedContent items={relatedItems} />

    <div class="my-10">
      <NewsletterForm variant="inline" />
    </div>
  </main>

  <Footer />
</Layout>
