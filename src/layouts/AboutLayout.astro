---
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import NewsletterForm from "@/components/NewsletterForm.astro";
import StructuredData from "@/components/StructuredData.astro";
import IconBrandX from "@/assets/icons/IconBrandX.svg";
import IconGitHub from "@/assets/icons/IconGitHub.svg";
import IconLinkedin from "@/assets/icons/IconLinkedin.svg";
import IconMail from "@/assets/icons/IconMail.svg";
import IconProductHunt from "@/assets/icons/IconProductHunt.svg";
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";
import { isAboutThinPage } from "@/utils/aboutPage";
import Layout from "./Layout.astro";

export interface Props {
  frontmatter: {
    title: string;
    description?: string;
  };
}

const { frontmatter } = Astro.props;

const slotContent = await Astro.slots.render("default");
const isThinPage = isAboutThinPage(SITE.bio, slotContent);

const iconMap = {
  github: IconGitHub,
  twitter: IconBrandX,
  linkedin: IconLinkedin,
  producthunt: IconProductHunt,
  mail: IconMail,
};

const hasBio = Boolean(SITE.bio && SITE.bio.trim() !== "" && !SITE.bio.trim().startsWith("TODO"));
const hasEmail = Boolean(SITE.email && SITE.email.trim() !== "" && !SITE.email.trim().startsWith("TODO"));
const activeSocials = SOCIALS.filter(
  (s) => s.active && Boolean(s.href) && !s.href.includes("TODO") && s.href.startsWith("https:"),
);

const hasSlotContent = Boolean(
  slotContent &&
    slotContent
      .replace(/<!--[\s\S]*?-->/g, "")
      .replace(/\{\/\*[\s\S]*?\*\/\}/g, "")
      .trim().length > 0,
);
---

<Layout
  title={`${frontmatter.title} | ${SITE.title}`}
  description={frontmatter.description || SITE.desc}
  markdownUrl="/about.md"
  noindex={isThinPage}
>
  <StructuredData type="AboutPage" />
  <Header />
  <main id="main-content" data-pagefind-ignore class="reading-container pb-12">
    <section id="about" class="mt-8">
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl mb-8">{frontmatter.title}</h1>

      <div class="flex flex-col sm:flex-row items-center sm:items-start gap-6 sm:gap-8 pb-8 border-b border-border/60">
        <img
          src="/about-photo.jpg"
          alt={SITE.author}
          class="size-44 sm:size-52 rounded-2xl shadow-sm border border-border/60 object-cover shrink-0"
          width="600"
          height="600"
        />

        <div class="flex-1">
          {hasBio && <p class="text-base sm:text-lg text-foreground/90 leading-relaxed font-medium">{SITE.bio}</p>}
        </div>
      </div>

      {
        hasSlotContent && (
          <div class="prose max-w-none mt-8">
            <Fragment set:html={slotContent} />
          </div>
        )
      }

      {
        activeSocials.length > 0 && (
          <section id="elsewhere" class="mt-12 pt-8 border-t border-border/60">
            <h2 class="text-xl font-bold mb-4">Elsewhere</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              {activeSocials.map((social) => {
                const IconComponent = iconMap[social.icon as keyof typeof iconMap];
                return (
                  <a
                    href={social.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center justify-between p-3.5 rounded-lg border border-border bg-surface hover:border-accent hover:text-accent transition-all group min-h-[48px]"
                  >
                    <div class="flex items-center gap-3">
                      {IconComponent && (
                        <IconComponent class="size-5 text-muted group-hover:text-accent transition-colors shrink-0" />
                      )}
                      <span class="font-medium text-foreground group-hover:text-accent text-sm">
                        {social.name}
                      </span>
                    </div>
                    <span class="text-xs text-muted group-hover:text-accent transition-transform group-hover:translate-x-0.5" aria-hidden="true">
                      &rarr;
                    </span>
                  </a>
                );
              })}
            </div>
          </section>
        )
      }

      {
        hasEmail && (
          <section id="contact" class="mt-8 pt-6 border-t border-border/60">
            <h2 class="text-xl font-bold mb-3">Contact</h2>
            <p class="text-sm text-foreground/80 mb-3">
              You can reach me directly by email:
            </p>
            <a
              href={`mailto:${SITE.email}`}
              class="inline-flex items-center gap-2.5 px-4 py-2.5 rounded-lg border border-border bg-surface hover:border-accent hover:text-accent text-sm font-medium transition-colors min-h-[44px]"
            >
              <IconMail class="size-4 text-muted shrink-0" />
              <span>{SITE.email}</span>
            </a>
          </section>
        )
      }

      <section id="subscribe" class="mt-12">
        <NewsletterForm variant="card" />
      </section>
    </section>
  </main>
  <Footer />
</Layout>
