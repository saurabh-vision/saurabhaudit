---
import { SITE } from "@/config";

interface StringTitleProp {
  pageTitle: string;
  pageDesc?: string;
}

interface ArrayTitleProp {
  pageTitle: [string, string];
  titleTransition: string;
  pageDesc?: string;
}

export type Props = StringTitleProp | ArrayTitleProp;

const { props } = Astro;

const backUrl = SITE.showBackButton ? Astro.url.pathname : "/";
---

<main
  data-backUrl={backUrl}
  id="main-content"
  data-pagefind-ignore
  class="wide-container pb-12"
>
  {
    "titleTransition" in props ? (
      <h1 class="mt-8 mb-2 text-3xl font-bold tracking-tight sm:text-4xl text-foreground">
        {props.pageTitle[0]}
        <span transition:name={props.titleTransition}>
          {props.pageTitle[1]}
        </span>
      </h1>
    ) : (
      <h1 class="mt-8 mb-2 text-3xl font-bold tracking-tight sm:text-4xl text-foreground">{props.pageTitle}</h1>
    )
  }
  {props.pageDesc && <p class="mb-8 text-base text-muted">{props.pageDesc}</p>}
  <slot />
</main>

<script>
  document.addEventListener("astro:page-load", () => {
    const mainContent: HTMLElement | null =
      document.querySelector("#main-content");
    const backUrl = mainContent?.dataset?.backurl;
    if (backUrl) {
      sessionStorage.setItem("backUrl", backUrl);
    }
  });
</script>
