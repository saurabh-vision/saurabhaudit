---
import { SITE } from "@/config";
import { getSubstackEmbedUrl, normalizeSubstackUrl } from "@/utils/substack";

export interface Props {
  variant?: "card" | "inline";
  heading?: string;
  description?: string;
}

const {
  variant = "card",
  heading = `Subscribe to ${SITE.substackName || "the newsletter"}`,
  description = "New posts on building systems that scale, straight to your inbox.",
} = Astro.props;
void heading;

const substackUrl = normalizeSubstackUrl(SITE.substackUrl);
const embedUrl = getSubstackEmbedUrl(SITE.substackUrl);
const substackName = SITE.substackName || "Substack";
---

{
  substackUrl && embedUrl && (
    <aside
      data-pagefind-ignore
      class:list={[
        "newsletter-form",
        variant === "card"
          ? "my-8 mx-auto w-full max-w-md"
          : "my-4 flex flex-wrap items-center justify-between gap-3 rounded-lg border border-border bg-surface px-4 py-3 text-sm",
      ]}
    >
      {variant === "card" ? (
        <div class="flex flex-col items-center">
          <div class="w-full overflow-hidden rounded-xl border border-border bg-surface shadow-xs transition-shadow hover:shadow-sm">
            <iframe
              src={embedUrl}
              width="100%"
              height="250"
              title={`Subscribe to ${substackName}`}
              loading="lazy"
              scrolling="no"
              frameborder="0"
              referrerpolicy="strict-origin-when-cross-origin"
              class="block h-[250px] w-full border-0"
              style="background: transparent;"
            />
          </div>
          <noscript>
            <p class="mt-2 text-center text-sm">
              <a
                href={substackUrl}
                target="_blank"
                rel="noopener"
                class="text-accent underline hover:opacity-80"
              >
                Prefer to subscribe on Substack? {substackName} &rarr;
              </a>
            </p>
          </noscript>
          <p class="mt-2 text-center text-xs text-muted">
            Prefer to subscribe on Substack?{" "}
            <a
              href={substackUrl}
              target="_blank"
              rel="noopener"
              class="text-accent underline underline-offset-2 hover:opacity-80"
            >
              {substackName} &rarr;
            </a>
          </p>
        </div>
      ) : (
        <div class="flex w-full flex-wrap items-center justify-between gap-3">
          <span class="opacity-90">{description}</span>
          <a
            href={substackUrl}
            target="_blank"
            rel="noopener"
            class="whitespace-nowrap font-medium text-accent underline underline-offset-2 hover:opacity-80"
          >
            {substackName} &rarr;
          </a>
        </div>
      )}
    </aside>
  )
}
