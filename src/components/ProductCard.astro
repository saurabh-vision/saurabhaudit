---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { getProductLinks, type ProductLink } from "@/utils/getProductLinks";
import { getProductPath } from "@/utils/getProductPath";
import {
  getProductStatusBadgeClass,
  getProductStatusLabel,
  getProductTypeLabel,
} from "@/utils/productLabels";

export interface Props {
  product: CollectionEntry<"products">;
  headingLevel?: "h2" | "h3";
}

const { product, headingLevel = "h2" } = Astro.props;
const { title, description, type, status, icon, links: rawLinks } = product.data;

const productPath = getProductPath(product.id);
const statusLabel = getProductStatusLabel(status);
const typeLabel = getProductTypeLabel(type);
const badgeClass = getProductStatusBadgeClass(status);

const { links, primaryLink } = getProductLinks(rawLinks);
const displayedLinks: ProductLink[] = primaryLink
  ? [primaryLink, ...links.filter((l) => l.key !== primaryLink.key)].slice(0, 3)
  : links.slice(0, 3);

function getAriaLabel(link: ProductLink): string {
  if (link.kind === "store") {
    return `Get ${title} on ${link.label}`;
  }
  if (link.kind === "github") {
    return `View ${title} source on GitHub`;
  }
  if (link.kind === "docs") {
    return `View documentation for ${title}`;
  }
  if (link.kind === "website") {
    return `Visit website for ${title}`;
  }
  return `Open ${link.label} for ${title}`;
}

const isImageIcon =
  typeof icon === "object" && icon !== null && "src" in (icon as Record<string, unknown>);
---

<li
  class="flex flex-col justify-between rounded-lg border border-border bg-surface p-5 sm:p-6 transition-all hover:border-accent/50 hover:shadow-sm h-full"
>
  <div>
    <div class="flex items-start gap-4">
      {
        icon && (
          <div class="shrink-0">
            {isImageIcon ? (
              <Image
                src={icon as any}
                alt=""
                width={48}
                height={48}
                class="size-12 rounded-lg object-cover border border-border/50"
              />
            ) : (
              <img
                src={icon as string}
                alt=""
                width="48"
                height="48"
                class="size-12 rounded-lg object-cover border border-border/50"
              />
            )}
          </div>
        )
      }
      <div class="flex-1 min-w-0">
        <div class="flex flex-wrap items-center gap-2 mb-2">
          <span class="text-xs uppercase tracking-wider text-muted font-medium">
            {typeLabel}
          </span>
          <span
            class:list={[
              "inline-block rounded-full px-2.5 py-0.5 text-xs uppercase tracking-wider font-medium",
              badgeClass,
            ]}
          >
            {statusLabel}
          </span>
        </div>
        {
          headingLevel === "h2" ? (
            <h2 class="text-lg font-bold leading-snug tracking-tight">
              <a
                href={productPath}
                class="hover:text-accent decoration-dashed underline-offset-4 hover:underline"
              >
                {title}
              </a>
            </h2>
          ) : (
            <h3 class="text-lg font-bold leading-snug tracking-tight">
              <a
                href={productPath}
                class="hover:text-accent decoration-dashed underline-offset-4 hover:underline"
              >
                {title}
              </a>
            </h3>
          )
        }
      </div>
    </div>
    <p class="mt-3 text-sm text-foreground/80 line-clamp-3 leading-relaxed">
      {description}
    </p>
  </div>

  {
    displayedLinks.length > 0 && (
      <div class="mt-6 flex flex-wrap items-center gap-2 pt-4 border-t border-border">
        {displayedLinks.map((link, idx) => {
          const isPrimary = idx === 0 && primaryLink && link.key === primaryLink.key;
          return (
            <a
              href={link.href}
              target="_blank"
              rel="noopener"
              aria-label={getAriaLabel(link)}
              class:list={[
                "inline-flex items-center justify-center rounded-md px-3.5 py-2 text-xs font-medium min-h-[40px] focus-outline transition-colors",
                isPrimary
                  ? "bg-accent font-semibold text-accent-contrast hover:opacity-90"
                  : "border border-border bg-surface-2 text-foreground/90 hover:border-accent hover:text-accent",
              ]}
            >
              {link.label}
            </a>
          );
        })}
      </div>
    )
  }
</li>
