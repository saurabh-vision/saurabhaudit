---
import { SITE } from "@/config";
import Socials from "./Socials.astro";

export interface Props {
  noMarginTop?: boolean;
}

const { noMarginTop = false } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer
  data-pagefind-ignore
  class:list={["w-full border-t border-border bg-background py-8 transition-colors", { "mt-auto": !noMarginTop }]}
>
  <div
    class="wide-container flex flex-col items-center justify-between gap-6 md:flex-row-reverse"
  >
    <div class="flex items-center justify-center">
      <Socials centered />
    </div>
    <div class="flex flex-col items-center gap-2 text-sm text-muted sm:flex-row sm:gap-3">
      <span>&#169; {currentYear} {SITE.author} &middot; Code MIT &middot; Content CC BY 4.0</span>
      {
        SITE.substackUrl && (
          <>
            <span class="hidden sm:inline" aria-hidden="true">&middot;</span>
            <a
              href={SITE.substackUrl}
              target="_blank"
              rel="noopener"
              class="font-medium text-foreground hover:text-accent hover:underline focus-outline"
            >
              Subscribe
            </a>
          </>
        )
      }
    </div>
  </div>
</footer>
